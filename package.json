{
  "name": "karasin",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "overrides": {
    "vite": "6.3.5",
    "@vitejs/plugin-react": "4.3.4"
  },
  "main": "index.js",
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "thesis:screenshots": "node scripts/capture-thesis-screenshots.mjs",
    "thesis:docx": "python scripts/md-to-docx.py",
    "thesis:eval": "python scripts/generate-evaluation-tables.py",
    "thesis:manual-annotate": "python scripts/annotate-manual-screenshots.py",
    "thesis:manual-docx": "python scripts/md-to-docx.py docs/THESIS_APPENDIX_MANUAL.md docs/THESIS_APPENDIX_MANUAL.docx",
    "thesis:manual": "npm run thesis:manual-annotate && npm run thesis:manual-docx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luck-nara/karasin.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/luck-nara/karasin/issues"
  },
  "homepage": "https://github.com/luck-nara/karasin#readme",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "^1.60.0"
  }
}
